@article{bousseksou:1995:747,
  title = {A {{Simple Ising-Like Model}} for {{Spin Conversion Including Molecular Vibrations}}},
  author = {Bousseksou, A and {Constant-Machado}, H and Varret, F},
  year = {1995},
  journal = {Journal de Physique I},
