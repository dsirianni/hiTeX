@article{zeng:2024:242501,
  title = {Broadening Access to Small-Molecule Parameterization with the Force Field Toolkit},
  author = {Zeng, Yunlin and Pavlova, Anna and Nelson, Philip M. and Glick, Zachary L. and Yang, Lan and Pang, Yui Tik and Spivak, Mariano and Licari, Giuseppe and Tajkhorshid, Emad and Sherrill, C. David and Gumbart, James C.},
  year = {2024},
