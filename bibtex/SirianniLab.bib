@article{melo:2024:345,
  title = {Chemiluminescence of a {{Firefly Luciferin Analogue Reveals}} That {{Formation}} of the {{Key Intermediate Responsible}} for {{Excited State Generation Occurs}} on a {{Fully Concerted Step}}},
  author = {Melo, Diego Ulysses and {Bergonzini de Lima}, Henrique and Reis, Roberta Albino and Boaro, Andreia and Gon{\c c}alves Costa Pinto, Alexander Garreta and Monteiro Leite Ciscato, Luiz Francisco and {Homem-de-Mello}, Paula and Bartoloni, Fernando Heering},
  year = {2024},
