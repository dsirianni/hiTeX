  journal = {Journal of the American Chemical Society},
  volume = {90},
  number = {6},
  pages = {1499--1509},
  issn = {0002-7863, 1520-5126},
  doi = {10.1021/ja01008a018},
  urldate = {2024-07-08},
  abstract = {From a variety of molecular orbital methods we have deduced significant and specific interactions among radical lobes in the same molecule separated by a number of intervening bonds. These are explored in detail for benzynes and didehydroconjugated molecules. The interaction (1) is shown to depend only on the orientation of the bonds between the radical lobes and the orientation of the lobes themselves, not on the specific molecule; (2) factors into direct (through-space) interactions proportional to the direct overlap and indirect (throughbond) coupling dependent on significant vicinal cis and, more important, trans overlaps; and (3) leads to the simpler splitting patterns as shown in the text by compounds 1-6 (Figure 3) where S and A beneath the geometrical outline indicate whether the symmetric (S, nt + n2) or the antisymmetric (A, m --- n2) combination of radical lobes is at lower energy. For a through-bond interaction over an odd number of bonds we give an argument for A falling naturally below S. The filling of A or S has a direct consequence on the stereochemistry of the reactions of the lowest singlet of these species.},
  langid = {english},
  file = {../../../Zotero/storage/3GWRFTJW/Hoffmann et al. - 1968 - Benzynes, dehydroconjugated molecules, and the int.pdf}
}

