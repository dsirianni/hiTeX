@article{ma:2024:095140,
  title = {Hidden Turbulence in van {{Gogh}}'s {{The Starry Night}}},
  author = {Ma, Yinxiang (马寅翔) and Cheng, Wanting (程婉婷) and Huang, Shidi (黄仕迪) and Schmitt, Fran{\c c}ois G. and Lin, Xin (林昕) and Huang, Yongxiang (黄永祥)},
  year = {2024},
