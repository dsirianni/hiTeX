@article{vila:2025:,
  title = {Efficient {{Variable-Time Implementation}} of the {{RT-EOM-CCSDT Approach}} for {{Core}} and {{Valence Ionization Spectral Functions}}},
  author = {Vila, F. D. and Kas, J. J. and Rehr, J. J. and Kowalski, K.},
