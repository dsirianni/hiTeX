@article{jedwabny:2021:1787,
  title = {Extension of an {{Atom}}--{{Atom Dispersion Function}} to {{Halogen Bonds}} and {{Its Use}} for {{Rational Design}} of {{Drugs}} and {{Biocatalysts}}},
