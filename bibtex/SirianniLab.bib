@article{burns:2024:152501,
  title = {{{QCManyBody}}: {{A}} Flexible Implementation of the Many-Body Expansion},
  shorttitle = {{{QCManyBody}}},
  author = {Burns, Lori A. and Sherrill, C. David and Pritchard, Benjamin P.},
