  year = {2023},
  month = jan,
  pages = {53--71},
  publisher = {Elsevier},
  doi = {10.1016/B978-0-323-90891-7.00016-5},
  urldate = {2024-07-16},
  abstract = {Bond-breaking and bond-forming processes are essential to describe chemical reactions; however, a rigorous theoretical approach is needed to unequivocally define them. Herewith, we describe and discuss the main concepts of catastrophe theory and how they relate to structural change. We also define a connectivity scheme by means of Bader's theory of atoms in molecules. Then, we analyze the connection between these two theories and show how they are used in the study of reaction mechanisms. We finally focus on the evolution of other integrated and local properties viz. ELF, IQA, MESP, localization and delocalization indices, and force analysis. We present how these theoretical approaches have been used alongside catastrophe theory to describe chemical changes in a more accurate and precise fashion.},
  isbn = {978-0-323-90891-7},
