@article{carlson:1993:1240,
  title = {Accuracy of Free Energies of Hydration for Organic Molecules from 6-31g*-Derived Partial Charges},
  author = {Carlson, Heather A. and Nguyen, Toan B. and Orozco, Modesto and Jorgensen, William L.},
  year = {1993},
  journal = {Journal of Computational Chemistry},
  volume = {14},
  number = {10},
  pages = {1240--1249},
  issn = {1096-987X},
  doi = {10.1002/jcc.540141013},
  urldate = {2022-03-09},
  abstract = {Absolute free energies of hydration have been computed for 13 diverse organic molecules using partial charges derived from ab initio 6-31G* wave functions. Both Mulliken charges and charges fit to the electrostatic potential surface (EPS) were considered in conjunction with OPLS Lennard--Jones parameters for the organic molecules and the TIP4P model of water. Monte Carlo simulations with statistical perturbation theory yielded relative free energies of hydration. These were converted to absolute quantities through perturbations to reference molecules for which absolute free energies of hydration had been obtained previously in TIP4P water. The average errors in the computed absolute free energies of hydration are 1.1 kcal/mol for the 6-31G* EPS charges and 4.0 kcal/mol for the Mulliken charges. For the EPS charges, the largest individual errors are under 2 kcal/mol except for acetamide, in which case the error is 3.7 kcal/mol. The hydrogen bonding between the organic solutes and water has also been characterized. {\copyright} John Wiley \& Sons, Inc.},
  langid = {english},
  file = {../../../Zotero/storage/UQ8Y6I63/jcc.html}
}

@incollection{carpio-martinez:2023:53,
  title = {Chapter 4 - {{Structural}} and Bond Evolutions during a Chemical Reaction},
