@article{menger:2020:7681,
  title = {{{PySurf}}: {{A Framework}} for {{Database Accelerated Direct Dynamics}}},
  shorttitle = {{{PySurf}}},
  author = {Menger, Maximilian F. S. J. and Ehrmaier, Johannes and Faraji, Shirin},
  year = {2020},
