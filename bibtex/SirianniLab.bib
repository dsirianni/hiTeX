@incollection{:2010:2636,
  title = {Staudinger [2+2] {{Cycloaddition}}},
  booktitle = {Comprehensive {{Organic Name Reactions}} and {{Reagents}}},
  year = {2010},
  pages = {2636--2641},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9780470638859.conrr594},
  urldate = {2024-07-16},
  abstract = {It is one of the simplest and most convenient methods for the preparation of 2-azetidinones (i.e., {$\beta$}-lactams) by the [2+2] cycloaddition of ketenes and imines in a convergent and stereocontrolled manner. Therefore, it is generally known as the Staudinger reaction. Occasionally, this reaction is also referred to as Staudinger [2+2] cycloaddition. It has been reported that the Staudinger [2+2] cycloaddition is not a pericyclic reaction, but a stepwise reaction involving a nucleophilic attack of an imine on ketene to form a zwitterionic intermediate, which cyclizes conrotatorily to form the {$\beta$}-lactam. The study finds that electron-donating groups on ketenes and electron-withdrawing groups on imines accelerate the direct ring closure, leading to the formation of cis-{$\beta$}-lactams; in contrast, the electron-withdrawing substituents on ketenes and electron-donating substituents on imines stabilize the zwitterionic intermediate and retard the direct ring closure. This reaction has been extensively modified which results in an improved isolation yield of {$\beta$}-lactam.},
  chapter = {594},
  copyright = {Copyright {\copyright} 2010 John Wiley \& Sons, Inc. All rights reserved.},
  isbn = {978-0-470-63885-9},
  langid = {english},
  keywords = {2-azetidinones,cis--lactam,quinine,trans--lactam},
  file = {../../../Zotero/storage/BTGJU99B/9780470638859.html}
}

