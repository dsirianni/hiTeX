@phdthesis{norton::,
  title = {Electronic Structures and Reactions of Organic Materials for Electronic and Optical Applications},
  author = {Norton, Joseph Edward},
  address = {United States -- California},
  urldate = {2024-07-16},
  abstract = {Electronic structure calculations have been used to interpret reactions and properties of molecules with potential applications for electronic and optical materials. Electronic structures, properties, and reactions of polyacenes are studied using DFT quantum mechanical methods in the first two chapters. Chapter 1 considers the ability of linear polyacene geometries to undergo large twisting deformations while resisting significant variations in electronic structure and properties. Chapter 2 focuses on the unusual equilibria of dihydroacenes. Intermolecular mechanisms involving bimolecular hydrogen transfer are found to be more energetically feasible than intramolecular mechanisms involving sigmatropic hydrogen shifts. The isomerization of the radical cations of Dewar benzene and hexamethyl Dewar benzene is studied in Chapter 3 in the context of a photoinduced electron transfer chain mechanism known as quantum amplificiation. The potential energy surfaces for ring opening of both systems are detailed using B3LYP and CASSCF methods. Two avoided crossings that link two stable minima are encountered. Electron-transfer rates and frequency-dependent indices of refraction are calculated for hexamethyl Dewar benzene. Chapter 4 presents a systematic analysis of orbital interactions in a series of polythiaadamantanes. The poor semiconducting properties of these electron-rich molecules are attributed to a surprisingly high ionization potential due to cumulative inductive effects of sulfur atoms. Separation of through-bond and through-space interactions in conjunction with H{\"u}ckel and NBO analysis provide a detailed explanation of B3LYP orbital splitting patterns. A discussion of electronic coupling between hexathiaadamantane dimers is provided. In Chapter 5, a unique mechanism for the photoisomerizaiton of hexatriene is described using CASPT2//CASSCF methods. Partial migration of a single hydrogen provides access to an efficient radiationless decay pathway that would allow simultaneous rotation about adjacent single and double bonds. While these structures have volume-conserving geometries, they are high in energy and would only be accessible in highly constrained media. Chapter 6 outlines methods of controlling thermal isomerization of substituted benzocyclobutenes to their corresponding o-xylylenes. Systems designed to exploit electrochemistry, acid/base chemistry, and torquoselectivity are reported.},
  copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
  isbn = {9780542901454},
  langid = {english},
  school = {University of California, Los Angeles},
  keywords = {Conical intersection,Electronic structures,Polyacenes,Polythiaadamantanes,Pure sciences},
  file = {../../../Zotero/storage/NQ2DVNX5/Norton - Electronic structures and reactions of organic mat.pdf}
}

@article{nottoli:2024:e1726,
  title = {{{ddX}}: {{Polarizable}} Continuum Solvation from Small Molecules to Proteins},
  shorttitle = {{{ddX}}},
  author = {Nottoli, Michele and Herbst, Michael F. and Mikhalev, Aleksandr and Jha, Abhinav and Lipparini, Filippo and Stamm, Benjamin},
  year = {2024},
  journal = {WIREs Computational Molecular Science},
