@article{langer:2023:6572,
  title = {Polymorphism of {{Butyl Ester}} of {{Oleanolic Acid}}---{{The Dominance}} of {{Dispersive Interactions}} over {{Electrostatic}}},
  author = {Langer, Dominik and Wicher, Barbara and Dutkiewicz, Zbigniew and {Bendzinska-Berus}, Wioletta and {Bednarczyk-Cwynar}, Barbara and Tykarska, Ewa},
  year = {2023},
  month = jan,
  journal = {International Journal of Molecular Sciences},
  volume = {24},
  number = {7},
  pages = {6572},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {1422-0067},
  doi = {10.3390/ijms24076572},
  urldate = {2023-04-07},
  abstract = {Oleanolic (OA) and glycyrrhetinic acids (GE), as well as their derivatives, show a variety of pharmacological properties. Their crystal structures provide valuable information related to the assembly modes of these biologically active compounds. In the known-to-date crystals of OA esters, their 11-oxo derivatives, and GE ester crystals, triterpenes associate, forming different types of ribbons and layers whose construction is based mainly on van der Waals forces and weak C-H{$\cdot\cdot\cdot$}O interactions. New crystal structures of 11-oxo OA methyl ester and the polymorph of OA butyl ester reveal an alternative aggregation mode. Supramolecular architectures consist of helical chains which are stabilized by hydrogen bonds of O-H{$\cdot\cdot\cdot$}O type. It was found that two polymorphic forms of butyl OA ester (layered and helical) are related monotropically. In a structure of metastable form, O-H{$\cdot\cdot\cdot$}O hydrogen bonds occur, while the thermodynamically preferred phase is governed mainly by van der Waals interactions. The intermolecular interaction energies calculated using CrystalExplorer, PIXEL, and Psi4 programs showed that even in motifs formed through O-H{$\cdot\cdot\cdot$}O hydrogen bonds, the dispersive forces have a significant impact.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {crystal structures,differential scanning calorimetry,hydrogen bonds,hydrophobic interactions,intermolecular energies calculations,intermolecular interaction,monotropic polymorphs,oleanolic acid esters,triterpenes},
  file = {../../../Zotero/storage/DA5QMJ9D/Langer et al. - 2023 - Polymorphism of Butyl Ester of Oleanolic Acid—The .pdf}
}

