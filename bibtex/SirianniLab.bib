@article{rezac:2015:19268,
  title = {Extensions and Applications of the {{A24}} Data Set of Accurate Interaction Energies},
  author = {{\v R}ez{\'a}{\v c}, Jan and Dubeck{\'y}, Mat{\'u}{\v s} and Jure{\v c}ka, Petr and Hobza, Pavel},
  year = {2015},
  month = jul,
  journal = {Phys. Chem. Chem. Phys.},
  volume = {17},
  number = {29},
  pages = {19268--19277},
  publisher = {The Royal Society of Chemistry},
  doi = {10.1039/C5CP03151F},
  abstract = {The A24 data set ({\v R}ez{\'a}{\v c} and Hobza, J. Chem. Theory Comput. 2013, 9, 2151--2155) is a set of noncovalent complexes large enough to showcase various types of interactions yet small enough to make highly accurate calculations possible. It is intended for the testing of accurate computational methods which are then used as a benchmark in larger model systems. In this work, we improve the best estimate of the interaction energies in the set by updating their CCSD(T)/CBS and CCSDT(Q) components with calculations in larger basis sets. The data set is then used to test a large number of composite CCSD(T) approaches. Special attention is paid to the use of the explicitly correlated MP2-F12 method in these composite calculations. It is shown that an accuracy of 1--2\% can be achieved with setups applicable to larger molecules. The effect of frozen natural orbital approximation on the accuracy of composite CCSD(T)/CBS calculations is also quantified. In four trivially saturated complexes where CCSDT(Q)/CBS data are now available, the convergence of the many-body correlation effects is assessed by fixed-node diffusion Monte Carlo (FN-DMC) calculations. A good agreement is achieved between FN-DMC and high-level coupled-cluster which represents an important cross-check of both approaches.},
  langid = {english},
  file = {../../../Zotero/storage/EVIKMGQJ/A9354304-EDD9-4CF0-A83F-87A037ED3C5D.pdf;../../../Zotero/storage/NKUN4QYL/A9354304-EDD9-4CF0-A83F-87A037ED3C5D.pdf}
}

