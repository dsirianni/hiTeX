@article{wang:2019:10772,
  title = {Molecular {{Dynamics}} of {{Combustion Reactions}} in {{Supercritical Carbon Dioxide}}. 6. {{Computational Kinetics}} of {{Reactions}} between {{Hydrogen Atom}} and {{Oxygen Molecule H}} + {{O2}} {$\rightleftharpoons$} {{HO}} + {{O}} and {{H}} + {{O2}} {$\rightleftharpoons$} {{HO2}}},
  author = {Wang, Chun-Hung and Masunov, Art{\"e}m E. and Allison, Timothy C. and Chang, Sungho and Lim, Chansun and Jin, Yuin and Vasu, Subith S.},
  year = {2019},
  month = dec,
  journal = {The Journal of Physical Chemistry A},
  volume = {123},
  number = {50},
  pages = {10772--10781},
  publisher = {American Chemical Society},
  issn = {1089-5639},
  doi = {10.1021/acs.jpca.9b08789},
  urldate = {2023-07-01},
  abstract = {Reactions of the hydrogen atom and the oxygen molecule are among the most important ones in the hydrogen and hydrocarbon oxidation mechanisms, including combustion in a supercritical CO2 (sCO2) environment, known as oxy-combustion or the Allam cycle. Development of these energy technologies requires understanding of chemical kinetics of H + O2 {$\rightleftharpoons$} HO + O and H + O2 {$\rightleftharpoons$} HO2 in high pressures and concentrations of CO2. Here, we combine quantum treatment of the reaction system by the transition state theory with classical molecular dynamics simulation and the multistate empirical valence bonding method to treat environmental effects. Potential of mean force in the sCO2 solvent at various temperatures 1000--2000 K and pressures 100--400 atm was obtained. The reaction rate for H + O2 {$\rightleftharpoons$} HO + O was found to be pressure-independent and described by the extended Arrhenius equation 4.23 {\texttimes} 10--7 T--0.73 exp(-21\,855.2 cal/mol/RT) cm3/molecule/s, while the reaction rate H + O2 {$\rightleftharpoons$} HO2 is pressure-dependent and can be expressed as 5.22 {\texttimes} 10--2 T--2.86 exp(-7247.4 cal/mol/RT) cm3/molecule/s at 300 atm.},
  file = {../../../Zotero/storage/9RUYVAVL/Wang et al. - 2019 - Molecular Dynamics of Combustion Reactions in Supe.pdf;../../../Zotero/storage/LTASMEEP/acs.jpca.html}
}

