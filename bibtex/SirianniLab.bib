@article{giovannini:2024:104110,
  title = {Kohn--{{Sham}} Fragment Energy Decomposition Analysis},
  author = {Giovannini, Tommaso},
  year = {2024},
  month = sep,
  journal = {The Journal of Chemical Physics},
  volume = {161},
  number = {10},
  pages = {104110},
  issn = {0021-9606},
  doi = {10.1063/5.0216596},
  urldate = {2024-09-16},
  abstract = {We introduce the concept of Kohn--Sham fragment localized molecular orbitals (KS-FLMOs), which are Kohn--Sham molecular orbitals (MOs) localized in specific fragments constituting a generic molecular system. In detail, we minimize the local electronic energies of various fragments, while maximizing the repulsion between them, resulting in the effective localization of the MOs. We use the developed KS-FLMOs to propose a novel energy decomposition analysis, which we name Kohn--Sham fragment energy decomposition analysis, which allows for rationalizing the main non-covalent interactions occurring in interacting systems both in vacuo and in solution, providing physical insights into non-covalent interactions. The method is validated against state-of-the-art energy decomposition analysis techniques and with high-level calculations.},
  file = {../../../Zotero/storage/3ZNGDYFB/Giovannini - 2024 - Kohn–Sham fragment energy decomposition analysis.pdf;../../../Zotero/storage/UFNUF75F/Kohn-Sham-fragment-energy-decomposition-analysis.html}
}

@article{glick:2024:134112,
  title = {Electrostatically Embedded Symmetry-Adapted Perturbation Theory},
  author = {Glick, Caroline S. and Alenaizan, Asem and Cheney, Daniel L. and Cavender, Chapin E. and Sherrill, C. David},
  year = {2024},
  month = oct,
  journal = {The Journal of Chemical Physics},
  volume = {161},
  number = {13},
  pages = {134112},
  issn = {0021-9606, 1089-7690},
  doi = {10.1063/5.0221974},
  urldate = {2024-10-07},
  abstract = {Symmetry-adapted perturbation theory (SAPT) is an ab initio approach that directly computes noncovalent interaction energies in terms of electrostatics, exchange repulsion, induction/polarization, and London dispersion components. Due to its high computational scaling, routine applications of even the lowest order of SAPT are typically limited to a few hundred atoms. To address this limitation, we report here the addition of electrostatic embedding to the SAPT (EE-SAPT) and ISAPT (EE-ISAPT) methods. We illustrate the embedding scheme using water trimer as a prototype example. Then, we show that EE-SAPT/EE-ISAPT can be applied for efficiently and accurately computing noncovalent interactions in large systems, including solvated dimers and protein--ligand systems. In the latter application, particular care must be taken to properly handle the quantum mechanics/molecular mechanics boundary when it cuts covalent bonds. We investigate various schemes for handling charges near this boundary and demonstrate which are most effective in the context of charge-embedded SAPT.},
  langid = {english},
  file = {../../../Zotero/storage/DXG3KYYN/Glick et al. - 2024 - Electrostatically embedded symmetry-adapted pertur.pdf}
}

