@article{kurita:2004:3013,
  title = {Relationship between Force Constants and Bond Lengths for {{CX}} ({{X}} = {{C}}, {{Si}}, {{Ge}}, {{N}}, {{P}}, {{As}}, {{O}}, {{S}}, {{Se}}, {{F}}, {{Cl}} and {{Br}}) Single and Multiple Bonds: Formulation of {{Badger}}'s Rule for Universal Use},
