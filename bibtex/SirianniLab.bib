@article{rubtsov:2019:1307,
  title = {The Features of Combustion of Hydrogen and Methane in Oxygen and Air in the Presence of Difluorodichloromethane Additives},
  author = {Rubtsov, Nikolai M. and Vinogradov, Alexey N. and Kalinin, Alexander P. and Rodionov, Alexey I. and Troshin, Kirill Ya. and Tsvetkov, Georgii I. and Seplyarskii, Boris S.},
