@article{houston:2024:1821,
  title = {Formic {{Acid}}--{{Ammonia Heterodimer}}: {{A New $\Delta$-Machine Learning CCSD}}({{T}})-{{Level Potential Energy Surface Allows Investigation}} of the {{Double Proton Transfer}}},
  shorttitle = {Formic {{Acid}}--{{Ammonia Heterodimer}}},
  author = {Houston, Paul L. and Qu, Chen and Yu, Qi and Pandey, Priyanka and Conte, Riccardo and Nandi, Apurba and Bowman, Joel M. and Kukolich, Stephen G.},
  year = {2024},
