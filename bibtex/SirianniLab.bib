@article{catalan:2004:1864,
  title = {On the Ordering of the First Two Excited Electronic States in All- {\emph{Trans}} Linear Polyenes},
  author = {Catal{\'a}n, J. and De Paz, J. L. G.},
  year = {2004},
  month = jan,
  journal = {The Journal of Chemical Physics},
  volume = {120},
  number = {4},
  pages = {1864--1872},
  issn = {0021-9606, 1089-7690},
  doi = {10.1063/1.1634556},
  urldate = {2024-09-15},
  abstract = {Reported experimental evidence of the relative position of the first two excited electronic states in linear polyenes was carefully examined and compared with that derived from time dependent density functional theory (TDDFT) theoretical calculations performed at the B3LYP level on optimized geometries. The energy values for the first two triplet states Bu3 and Ag3, obtained from TDDFT calculations, were found to be highly strongly correlated with the experimental values. Also, the theoretical calculations for the electronic transition 1{$\mkern1mu$}1Ag{$\rightarrow$}1{$\mkern1mu$}1Bu were also extremely well correlated with their experimental counterparts; even more important, the three reported experimental data for 1{$\mkern1mu$}1Ag{$\rightarrow$}2{$\mkern1mu$}1Ag transitions in these systems conformed to the correlation for the TDDFT 1{$\mkern1mu$}1Ag{$\rightarrow$}1{$\mkern1mu$}1Bu transition. The first excited electronic state in the linear polyenes studied (from ethene to the compound consisting of 40 ethene units, P40) was found to be Bu1. The energy gap between the excited states 2{$\mkern1mu$}1Ag and 1{$\mkern1mu$}1Bu decreased with increasing length of the polyene chain, but not to the extent required to cause inversion, at least up to P40. In the all-trans linear polyenes studied, the widely analyzed energy gap from the ground electronic state to the first excited singlet state for infinitely long chains may be meaningless as, even in P40, it is uncertain whether the ground electronic state continues to be a singlet.},
  langid = {english}
}

@article{catalan:2005:3915,
  title = {Electronic {{Energy Levels}} in All-Trans {{Long Linear Polyenes}}: {{The Case}} of the 3,20-{{Di}}(Tert-Butyl)-2,2,21,21-Tetramethyl-All-Trans-3,5,7,9,11,13,15,17,19-Docosanonaen (Ttbp9) {{Conforming}} to {{Kasha}}'s {{Rule}}},
  shorttitle = {Electronic {{Energy Levels}} in All-Trans {{Long Linear Polyenes}}},
  author = {Catal{\'a}n, Javier and Hopf, Henning and Mlynek, Cornelia and Klein, Dagmar and Kilickiran, Pinar},
  year = {2005},
  journal = {Chemistry -- A European Journal},
  volume = {11},
  number = {13},
  pages = {3915--3920},
  issn = {1521-3765},
  doi = {10.1002/chem.200401093},
  urldate = {2024-09-16},
  abstract = {The absorption, fluorescence and fluorescence excitation spectra for 3,20-di(tert-butyl)-2,2,21,21-tetramethyl-all-trans-3,5,7,9,11,13,15,17,19-docosanonaen (ttbP9) in dilute solutions of 2-methylbutane were recorded at temperatures over the range 120--280 K. The high photostability of this nonaene allows us to assert that it exhibits a single fluorescence and that this can be unequivocally assigned to emission from its 11Bu excited state, it being the first excited electronic state. Available photophysical data for this polyene and the wealth of information reported for shorter all-trans polyenes allow us to conclude that if the first excited electronic state for the chromophore possessed 21Ag symmetry, then the energy of such a state might have been so close to that of the 11Bu state that: 1) the radiationless internal conversion mechanism would preclude the observation of the emission from the 11Bu state reported in this work and 2) the 21Ag state reached through internal conversion would be vibrationally coupled to 11Bu and would facilitate the detection of the emission from 21Ag, which was not observed in any of the solvents used in this work. The spectroscopic and photochemical implications of these findings for other polyenes are discussed.},
  copyright = {Copyright {\copyright} 2005 WILEY-VCH Verlag GmbH \& Co. KGaA, Weinheim},
  langid = {english},
  keywords = {absorption,fluorescence spectroscopy,Kasha's rule,photochemistry,polyenes},
  file = {../../../Zotero/storage/GY7WG5RC/Catalán et al. - 2005 - Electronic Energy Levels in all-trans Long Linear .pdf;../../../Zotero/storage/FAQS8SNS/chem.html}
}

