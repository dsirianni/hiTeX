  abstract = {This study provides basic information on the strength, range, and nature of the interaction in adducts formed between mercury and noble gases by combining the results of advanced theoretical methods. This information has been coupled with a comprehensive investigation of such adducts' spectroscopic and thermodynamical properties over a temperature range of applied interest. Interaction energy decomposition, rovibrational energies, spectroscopic constants, lifetimes, Atoms in Molecule analysis, thermochemical data, and vibrational population analysis were determined. The calculated spectroscopic constants show excellent agreement with available experimental data, while the lifetime calculations indicate that the Ng-Hg systems are stable within the probed temperature range. The stabilization of the Ng-Hg formation arises from the dispersion attraction, suggesting a typical noncovalent interaction. The higher vibrational levels are the most populated, suggesting that these systems may have potential applications in lasers, particularly the Ne-Hg adduct. This comprehensive theoretical study fills key knowledge gaps about intriguing Ng-Hg systems.},
  keywords = {Adducts between noble gases and mercury,Atoms-in-molecules,Charge transfer,Noncovalent interaction,Potential energy curves,Spectroscopic constants},
  file = {../../../Zotero/storage/Y4U52QTL/S2210271X24003360.html}
}

@article{derricotte:2019:7881,
