@article{hoffmann:1968:1499a,
  title = {Benzynes, Dehydroconjugated Molecules, and the Interaction of Orbitals Separated by a Number of Intervening Sigma Bonds},
  author = {Hoffmann, Roald and Imamura, Akira and Hehre, Warren J.},
  year = {1968},
