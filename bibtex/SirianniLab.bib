@article{krep:2020:e1900043,
  title = {Exploring the {{Chemistry}} of {{Low-Temperature Ignition}} by {{Pressure-Accelerated Dynamics}}},
  author = {Krep, Lukas and Kopp, Wassja Alexander and Kr{\"o}ger, Leif Christian and D{\"o}ntgen, Malte and Leonhard, Kai},
  year = {2020},
  journal = {ChemSystemsChem},
  volume = {2},
  number = {4},
  pages = {e1900043},
  issn = {2570-4206},
  doi = {10.1002/syst.201900043},
  urldate = {2023-07-04},
  abstract = {Reaction models that accurately describe the complex reaction processes of ignition are key for the development of novel engine- and fuel concepts. Since reactive molecular dynamics can be used to discover reaction networks in a largely automated fashion, this method has the potential to drastically reduce the real time effort necessary for the development of reaction models. With standard reactive molecular dynamics, the simulation of low-temperature reaction processes is hindered by the small accessible time scales of only a few nanoseconds. In this work, we propose the pressure-accelerated dynamics method to overcome the time scales obstacle through exploitation of Le Chatelier's principle. For the example of pentane low-temperature ignition, we show that with pressure-accelerated dynamics, the ReaxFF reactive force field, and the ChemTraYzer not only the known key low-temperature igniton pathways can be found, but also reactions that are not yet included in reaction models.},
  copyright = {{\copyright} 2020 The Authors. Published by Wiley-VCH Verlag GmbH \& Co. KGaA},
  langid = {english},
  keywords = {acceleration methods,ChemTraYzer,low-temperature ignition,pentane,ReaxFF},
  file = {../../../Zotero/storage/FZGEAWPX/Krep et al. - 2020 - Exploring the Chemistry of Low-Temperature Ignition by Pressure-Accelerated Dynamics.pdf}
}

@article{krishnamoorthy:2020:012182,
  title = {Reactive Molecular Dynamics Simulations and Machine Learning},
  author = {Krishnamoorthy, Aravind and Rajak, Pankaj and Hong, Sungwook and Nomura, Ken-ichi and Tiwari, Subodh and Kalia, Rajiv K. and Nakano, Aiichiro and Vashishta, Priya},
