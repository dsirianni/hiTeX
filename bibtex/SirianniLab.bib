@article{panteleev:2018:897,
  title = {Molecular {{Dynamics Study}} of {{Combustion Reactions}} in a {{Supercritical Environment}}. {{Part}} 2: {{Boxed MD Study}} of {{CO}} + {{OH}} {$\rightarrow$} {{CO2}} + {{H Reaction Kinetics}}},
  shorttitle = {Molecular {{Dynamics Study}} of {{Combustion Reactions}} in a {{Supercritical Environment}}. {{Part}} 2},
  author = {Panteleev, Sergey V. and Masunov, Art{\"e}m E. and Vasu, Subith S.},
  year = {2018},
