@article{hu:2023:,
  title = {Efficient {{Computation}} of the {{Electrostatic Component}} of {{Solvation Free Energy}} via a {{Two-Point Pad{\'e} Approximation}}},
  author = {Hu, Hao and Yang, Weitao and Liu, Shubin},
  year = {2023},
