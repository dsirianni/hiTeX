  number = {11},
  pages = {6918--6933},
  publisher = {American Chemical Society},
  issn = {1549-9618},
  doi = {10.1021/acs.jctc.1c00709},
  urldate = {2024-06-15},
  abstract = {Previously unknown properties of the natural orbitals (NOs) pertaining to singlet states (with natural parity, if present) of electronic systems with even numbers of electrons are revealed upon the demonstration that, at the limit of n {$\rightarrow$} {$\infty$}, the NO {$\psi$}n(r⃗) with the nth largest occupation number {$\nu$}n approaches the solution {\~undefined}n(r⃗) of the zero-energy Schr{\"o}dinger equation that reads {\^T}([{$\rho$}2(r⃗,\,r⃗)]-1/8\,{\~undefined}n(r⃗))\,-\,({$\pi$}2/{\~v}n)1/4\,[{$\rho$}2(r⃗,\,r⃗)]1/4\,([{$\rho$}2(r⃗,\,r⃗)]-1/8\,{\~undefined}n(r⃗)) = 0 (where {\^T} is the kinetic energy operator), whereas {$\nu$}n approaches {\~undefined}n. The resulting formalism, in which the ``on-top'' two-electron density {$\rho$}2(r⃗,\,r⃗) solely controls the asymptotic behavior of both {$\psi$}n(r⃗) and {$\nu$}n at the limit of the latter becoming infinitesimally small, produces surprisingly accurate values of both quantities even for small n. It opens entirely new vistas in the elucidation of their properties, including single-line derivations of the power laws governing the asymptotic decays of {$\nu$}n and {$\langle\psi$}n(r⃗){\textbar}{\^T}{\textbar}{$\psi$}n(r⃗){$\rangle$} with n, some of which have been obtained previously with tedious algebra and arcane mathematical arguments. These laws imply a very unfavorable asymptotics of the truncation error in the total energy computed with finite numbers of natural orbitals that severely affects the accuracy of certain quantum-chemical approaches such as the density matrix functional theory. The new formalism is also shown to provide a complete and accurate elucidation of both the observed order (according to decreasing magnitudes of the respective occupation numbers) and the shapes of the natural orbitals pertaining to the 1{$\Sigma$}g+ ground state of the H2 molecule. In light of these examples of its versatility, the above Schr{\"o}dinger equation is expected to have its predictive and interpretive powers harnessed in many facets of the electronic structure theory.},
  file = {../../../Zotero/storage/QB3CNIRQ/Cioslowski and Strasburger - 2021 - From Fredholm to Schrödinger via Eikonal A New Fo.pdf}
}

