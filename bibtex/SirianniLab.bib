@article{nava:2014:16196,
  title = {On the Ring-Opening of Substituted Cyclobutene to Benzocyclobutene: Analysis of {$\pi$} Delocalization, Hyperconjugation, and Ring Strain},
  shorttitle = {On the Ring-Opening of Substituted Cyclobutene to Benzocyclobutene},
  author = {Nava, Paola and Carissan, Yannick},
  year = {2014},
