@article{lawal:2024:13,
  title = {An {{Undergraduate Computational Chemistry Experiment}}: {{Investigation}} of the {{E2 Elimination Reaction}} of 2-{{Bromopropane}} to {{Propene}}},
  shorttitle = {An {{Undergraduate Computational Chemistry Experiment}}},
  author = {Lawal, Monsurat M. and Kucukkal, Tugba G.},
  year = {2024},
