@article{mehl:2011:193,
  title = {Kinetic Modeling of Gasoline Surrogate Components and Mixtures under Engine Conditions},
  author = {Mehl, Marco and Pitz, William J. and Westbrook, Charles K. and Curran, Henry J.},
  year = {2011},
