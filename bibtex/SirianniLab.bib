  abstract = {Molecular modeling enables a systematic approach in process development. The core of molecular modeling is to provide a robust kinetic model, so that reliability in generic prediction of product yields can be improved. One major challenge in developing kinetic model is to build a sufficiently complete reaction network from mechanisms and kinetic parameters. Current approaches heavily rely on known chemistry and processes, which does not work well for new process and/or materials development. In this work, we integrate DFT based adaptive kinetic Monte Carlo (AKMC) into molecular modeling, so that a rather complete reaction network with better estimates of kinetic parameters could be built for kinetic modeling without assuming reaction mechanisms, setting foundation for a robust kinetic model. AKMC can also serve as an important supplement to kinetic modeling. The inherent automation in AKMC via first principle calculations is the foundation for future integration with data science approaches.},
  keywords = {AKMC,DFT,Kinetic model,Molecular modeling,Process development,Reaction network},
  file = {../../../Zotero/storage/GQPN5CJD/Xu and Zhu - 2020 - A new way to develop reaction network automaticall.pdf;../../../Zotero/storage/ABXK7EKU/S0009250920302785.html}
}

@article{xu:2022:3064,
  title = {A Supramolecular Photosensitizer Derived from an {{Arene-Ru}}({{II}}) Complex Self-Assembly for {{NIR}} Activated Photodynamic and Photothermal Therapy},
  author = {Xu, Gang and Li, Chengwei and Chi, Chen and Wu, Luyan and Sun, Yanyan and Zhao, Jian and Xia, Xing-Hua and Gou, Shaohua},
  year = {2022},
  month = jun,
  journal = {Nature Communications},
  volume = {13},
  number = {1},
  pages = {3064},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-022-30721-w},
  urldate = {2024-10-20},
  abstract = {Effective photosensitizers are of particular importance for the widespread clinical utilization of phototherapy. However, conventional photosensitizers are usually plagued by short-wavelength absorption, inadequate photostability, low reactive oxygen species (ROS) quantum yields, and aggregation-caused ROS quenching. Here, we report a near-infrared (NIR)-supramolecular photosensitizer (RuDA) via self-assembly of an organometallic Ru(II)-arene complex in aqueous solution. RuDA can generate singlet oxygen (1O2) only in aggregate state, showing distinct aggregation-induced 1O2 generation behavior due to the greatly increased singlet-triplet intersystem crossing process. Upon 808\,nm laser irradiation, RuDA with excellent photostability displays efficient 1O2 and heat generation in a 1O2 quantum yield of 16.4\% (FDA-approved indocyanine green: {$\Phi\Delta$}\,=\,0.2\%) together with high photothermal conversion efficiency of 24.2\% (commercial gold nanorods: 21.0\%, gold nanoshells: 13.0\%). In addition, RuDA-NPs with good biocompatibility can be preferably accumulated at tumor sites, inducing significant tumor regression with a 95.2\% tumor volume reduction in vivo during photodynamic therapy. This aggregation enhanced photodynamic therapy provides a strategy for the design of photosensitizers with promising photophysical and photochemical characteristics.},
  copyright = {2022 The Author(s)},
  langid = {english},
  keywords = {Drug development,Targeted therapies},
  file = {../../../Zotero/storage/Q73N92EA/Xu et al. - 2022 - A supramolecular photosensitizer derived from an A.pdf}
}

