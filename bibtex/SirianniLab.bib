@phdthesis{kallel::,
  title = {Theoretical Studies of Torquoselectivity in Thermal and Photochemical Electrocyclic Reactions},
  author = {Kallel, Edward Adam},
  address = {United States -- California},
  urldate = {2024-07-16},
  abstract = {Substituent effects on the ground state geometries and conrotatory electrocyclizations of cyclobutenes, cyclobutenones, pentadienyl cations, cyclopropyl anions, axetines, thietenes, and oxetenes were studied. In the cyclobutene electrocyclic ring opening, the effect of substitution at the 1 position is minor and is a result of a slight elevation of the \${\textbackslash}pi\$ bonding orbital, causing the \${\textbackslash}pi\$ bond to become better donor causing donor substituents to raise the activation energy and acceptor substituents to lower the activation energy. Substituents on C-3 cause small distortions of the cyclobutene ground states. Donors prefer outward rotation, while acceptors prefer inward rotation. The activation energy and ground state geometric perturbations were found to correlate with the Taft \${\textbackslash}sigma{\textbackslash}sb\{{\textbackslash}rm R\}{\textbackslash}sp0\$ parameter. A wide variety of substituents were calculated in the 1 and 3 positions. The conrotatory preference of substituents correlated well with the Taft \${\textbackslash}sigma{\textbackslash}sb\{{\textbackslash}rm R\}{\textbackslash}sp0\$ parameter. In cyclobutenone, the direction of rotation of the substituent was found to be governed by the same factors as cyclobutene. The \${\textbackslash}pi\$-\${\textbackslash}pi{\textbackslash}sp*\$ triplet states was found to be lowest for cyclobutenone; however reactivity was predicted to be controlled by the n-\${\textbackslash}pi{\textbackslash}sp*\$ triplet surface, which becomes lower in energy during the photochemical ring opening. Cyclopropyl anion, azetine, Thietene, and oxetene were also found to exhibit torquoselectivity similar to cyclobutene. Cis-3,4-dimethylcyclobutene was found to possess a destabilizing steric interaction elevating the energy of the ground state, which leads to the earlier reports of anomalous acceleration of the rates of this compounds electrocylic ring opening. Pentadienyl cation was predicted to have an activation energy of 1-10 kcal/mol. The heat of reaction was predicted to be \$-\$27 to \$-\$34 kcal/mol. Constraint of various moities of the transition state for the electrocyclic ring opening of cyclobutene to planarity lead to increased activation barriers for the conrotatory opening. These distortions predict that the conrotatory opening can be destabilized enough to allow the monorotatory pathway to compete.},
  copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
  isbn = {9798207448657},
  langid = {english},
  school = {University of California, Los Angeles},
  keywords = {electrocyclization,Pure sciences,thermal electrocyclic reactions}
}

@article{kang:2019:20525,
  title = {Glucose to 5-{{Hydroxymethylfurfural}}: {{Origin}} of {{Site-Selectivity Resolved}} by {{Machine Learning Based Reaction Sampling}}},
  shorttitle = {Glucose to 5-{{Hydroxymethylfurfural}}},
  author = {Kang, Pei-Lin and Shang, Cheng and Liu, Zhi-Pan},
  year = {2019},
  month = dec,
  journal = {Journal of the American Chemical Society},
  volume = {141},
  number = {51},
  pages = {20525--20536},
  publisher = {American Chemical Society},
  issn = {0002-7863},
  doi = {10.1021/jacs.9b11535},
  urldate = {2023-08-09},
  abstract = {Glucose pyrolysis, a model system in biomass utilization, is renowned for its great complexity, deep in reaction network hierarchy and rich in reaction patterns. The selectivity in glucose pyrolysis, e.g., the high yield of 5-hydroxymethylfurfural (HMF), a value-added platform product, remains an intriguing puzzle even after 60 years of experimental study. Here we resolve the whole reaction network of glucose pyrolysis using a global-to-global technique for reaction pathway sampling. This is achieved by establishing the first organic chemistry reaction database via stochastic surface walking (SSW) global optimization, building the global neural network (G-NN) potential via machine learning and extensively exploring the reaction network of glucose pyrolysis. In total, 6407 elementary reactions, screened out from more than 150\,000 reaction pairs in glucose pyrolysis, are collected in our reaction database. The established reaction network from SSW-NN, further validated by first-principles calculations, reveals that for glucose to HMF, the lowest energy reaction pathway involves fructose and 3-deoxyglucos-2-ene (3-DGE) as key intermediates and a site-selective reaction type, retro-Michael-addition, for three consecutive dehydration steps. The overall barrier is determined to be 1.91 eV, being at least 0.19 eV lower than all previously proposed mechanisms, which assumes direct {$\beta$}-H elimination dehydration. The lowest pathways to the other two major products, furfural (FF) and hydroxyacetaldehyde (HAA), are also discovered with a similar barrier 1.95 eV, which exhibit a competing nature by sharing the same key intermediate, 3-ketohexose. Since chemical reactions occurring in fast glucose pyrolysis are generally present in biomass chemistry, containing essentially all reaction patterns of C--H--O elements, the methodology designed and the results presented would help to advance reaction design and mechanistic modeling in renewable fuels from biomass.},
  file = {../../../Zotero/storage/2PD59MMH/ja9b11535_si_001.pdf;../../../Zotero/storage/6IY7RHRH/Kang et al. - 2019 - Glucose to 5-Hydroxymethylfurfural Origin of Site.pdf;../../../Zotero/storage/TIQGGKQM/jacs.html}
}

