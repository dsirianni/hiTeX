  number = {19},
  pages = {8517--8528},
  publisher = {American Chemical Society},
  issn = {1549-9618},
  doi = {10.1021/acs.jctc.4c00644},
  urldate = {2024-10-13},
  abstract = {The exploration of the root structure of coupled cluster (CC) equations holds both foundational and practical significance for computational quantum chemistry. This study provides insight into the intricate root structures of these nonlinear equations at both the CCD and CCSD level of theory. We utilize computational techniques from algebraic geometry, specifically the monodromy and parametric homotopy continuation methods, to calculate the full solution set. We compare the computed CC roots against various established theoretical upper bounds, shedding light on the accuracy and efficiency of these bounds. We hereby focus on the dissociation processes of four-electron systems such as (H2)2 in both D2h and D{$\infty$}h configurations, H4 symmetrically distorted on a circle, and lithium hydride. We moreover investigate the ability of single-reference CC solutions to approximate excited state energies. We find that multiple CC roots describe energies of excited states with high accuracy. Our investigations reveal that for systems like lithium hydride, CC not only provides high-accuracy approximations to several excited state energies but also to the states themselves.},
  file = {../../../Zotero/storage/SIW5ACLD/Sverrisdóttir and Faulstich - 2024 - Exploring Ground and Excited States Via Single Ref.pdf}
}

@article{swarnkar:2024:1,
  title = {Determinants of Chemoselectivity in Ubiquitination by the {{J2}} Family of Ubiquitin-Conjugating Enzymes},
  author = {Swarnkar, Anuruti and Leidner, Florian and Rout, Ashok K and Ainatzi, Sofia and Schmidt, Claudia C and Becker, Stefan and Urlaub, Henning and Griesinger, Christian and Grubm{\"u}ller, Helmut and Stein, Alexander},
  year = {2024},
