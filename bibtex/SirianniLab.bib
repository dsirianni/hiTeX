@article{seeman:2015:11632,
  title = {Woodward--{{Hoffmann}}'s {{Stereochemistry}} of {{Electrocyclic Reactions}}: {{From Day}} 1 to the {{JACS Receipt Date}} ({{May}} 5, 1964 to {{November}} 30, 1964)},
