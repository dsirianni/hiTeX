  urldate = {2024-07-16},
  abstract = {This chapter introduces pericyclic reactions, their classification and three principal mechanistic approaches, namely the orbital symmetry correlation approach, the transition structure (TS) aromaticity approach and the frontier molecular orbital (FMO) approach for analysis. The Woodward--Hoffmann generalized rules which have the origin in orbital symmetry correlation approach have been described and illustrated with cycloaddition reactions, electrocyclic reactions, sigmatropic rearrangements and group transfer reactions. Further, selection rules are derived for all four pericyclic classes. The three mechanistic approaches provide the same selection rules. The relative stability of chair and boat TSs in terms of orbital interactions is described. A unifying method of analysis in terms of the three approaches linked through orbital picture representation is presented throughout.},
  isbn = {978-0-12-814958-4},
  keywords = {Cycloaddition,Electrocyclic reaction,Frontier orbital approach,Group transfer reaction,Huckel/Mobius system,Orbital mechanism,Pericyclic reaction,Selection rule,Sigmatropic rearrangement,Woodward-Hoffmann generalized rule},
