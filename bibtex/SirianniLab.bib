@article{alessa:2024:114864,
  title = {Investigation of {{Chrysene}} Heterodimers Complexes Potential Energy Surface Using {\emph{Ab Initio}} Computational Methods},
  author = {Alessa, Ali Hamzah},
  year = {2024},
