  langid = {english},
  keywords = {Catalysis,Computational chemistry,Density functional theory,Method development,Physical chemistry},
  file = {../../../Zotero/storage/75V72DGW/Stocker et al. - 2020 - Machine learning in chemical reaction space.pdf}
}

@article{stockwell:2012:1,
