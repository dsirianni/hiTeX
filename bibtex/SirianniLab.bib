  pages = {293--341},
  publisher = {Elsevier},
  doi = {10.1016/B978-0-12-814958-4.00007-6},
  urldate = {2024-07-16},
  abstract = {This chapter describes the torquoselectivity and stereochemistry of electrocyclic reactions in neutral and charged systems. A stereochemical rule has been formulated to depict product stereochemistry in conrotatory and disrotatory reactions. In neutral systems, the 4-electron electrocyclic reactions are described with regard to relative rates, torquoselectivity and stereochemical outcome. The 6-electron reactions are presented with particular reference to valence tautomerism in cyclic systems and stereochemical features. The regioselectivity in photocyclization of substituted cycloheptatrienes is included. The electrocyclic processes in natural products and bicyclic systems and 8-electron reactions are also described. In charged systems, the 2-electron reactions in cations with reference to torquoselectivity, relative rates and product stereochemistry are described. The Nazarov cyclization as a 4-electron process in cations is presented with directed cyclization, regioselectivity and stereochemistry. The electrocyclic reactions in anions as a 4-electron or 6-electron process are also included.},
  isbn = {978-0-12-814958-4},
  keywords = {Electrocyclic reaction,Nazarov cyclization,Neutral and charged systems,Photocyclization,Reactivity,Regioselectivity,Stereochemical rule,Stereochemistry,Torquoselectivity,Valence tautomerism},
  file = {../../../Zotero/storage/EDVSURRM/Mandal - 2018 - Chapter 7 - Electrocyclic Reactions Stereochemist.pdf}
}

