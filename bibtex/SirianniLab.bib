@article{huang:2024:,
  title = {Benchmark {{Study}} of {{Core-Ionization Energies}} with the {{Generalized Active Space-Driven Similarity Renormalization Group}}},
  author = {Huang, Meng and Evangelista, Francesco A.},
  year = {2024},
  month = sep,
  journal = {Journal of Chemical Theory and Computation},
  publisher = {American Chemical Society},
  issn = {1549-9618},
  doi = {10.1021/acs.jctc.4c00835},
  urldate = {2024-09-17},
  abstract = {X-ray photoelectron spectroscopy (XPS) is a powerful experimental technique for probing the electronic structure of molecules and materials; however, interpreting XPS data requires accurate computational methods to model core-ionized states. This work proposes and benchmarks a new approach based on the generalized active space-driven similarity renormalization group (GAS-DSRG) for calculating core-ionization energies and treating correlation effects at the perturbative and nonperturbative levels. We tested the GAS-DSRG across three data sets. First, the vertical core-ionization energies of small molecules containing first-row elements are evaluated. GAS-DSRG achieves mean absolute errors below 0.3 eV, which is comparable to high-level coupled cluster methods. Next, the accuracy of GAS-DSRG is evaluated for larger organic molecules using the CORE65 data set, with the DSRG-MRPT3 level yielding a mean absolute error of only 0.34 eV for 65 core-ionization transitions. Insights are provided into the treatment of static and dynamic correlation, the importance of high-order perturbation theory, and notable differences from density functional theory in the predicted energy ordering of core-ionized states for specific molecules. Finally, vibrationally resolved XPS spectra of diatomic molecules (CO, N2, and O2) are simulated, showing excellent agreement with experimental data.},
  file = {../../../Zotero/storage/7KYAITTJ/Huang and Evangelista - 2024 - Benchmark Study of Core-Ionization Energies with t.pdf}
}

