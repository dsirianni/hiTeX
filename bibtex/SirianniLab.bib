@incollection{mandal:2018:107,
  title = {Chapter 4 - {{Cycloadditions}} 1: {{Perturbation Theory}} of {{Reactivity}}, {{Regioselectivity}} and {{Periselectivity}}},
  shorttitle = {Chapter 4 - {{Cycloadditions}} 1},
  booktitle = {Pericyclic {{Chemistry}}},
  author = {Mandal, Dipak K.},
  editor = {Mandal, Dipak K.},
  year = {2018},
  month = jan,
  pages = {107--190},
  publisher = {Elsevier},
  doi = {10.1016/B978-0-12-814958-4.00004-0},
  urldate = {2024-07-16},
  abstract = {This chapter introduces perturbational molecular orbital theory using the Salem--Klopman equation. For cycloadditions, the equation is simplified to a frontier orbital expression and this is applied to predict and rationalize the features of reactivity, regioselectivity and periselectivity. The Diels--Alder reaction with different substitution patterns of the reacting components has been dealt with in respect of its frontier orbital control and `ortho/para' selectivity. The features of site selectivity, Lewis acid catalysis and regiochemical preference of hetero Diels--Alder reaction, Diels--Alder/retro-Diels--Alder sequence as a synthetic strategy and dehydro-Diels--Alder reactions are also described. The 1,3-dipolar cycloadditions and their regioselectivity using frontier orbital analysis are presented taking a variety of 1,3-dipoles employed for heterocyclic synthesis. A brief description of diyl cycloadditions using trimethylenemethane is included. The periselectivity in cycloadditions including fulvene cycloadditions has been analyzed using frontier orbital theory. Finally two useful cycloadditions involving singlet oxygen and ozone are described.},
  isbn = {978-0-12-814958-4},
  keywords = {13-Dipolar cycloaddition,Cycloaddition,Diels-Alder reaction,Diels-Alder/retro-Diels-Alder strategy,Frontier orbital theory,Periselectivity,Reactivity,Regioselectivity,Salem-Klopman equation,Site selectivity},
  file = {../../../Zotero/storage/ARJ7N5VU/Mandal - 2018 - Chapter 4 - Cycloadditions 1 Perturbation Theory .pdf}
}

@incollection{mandal:2018:191,
