@article{singh:2024:8624,
  title = {Configuration {{Interaction}} in {{Frontier Molecular Orbital Basis}} for {{Screening}} the {{Spin-Correlated}}, {{Spatially Separated Triplet Pair State}} 1({{T}}{$\cdot\cdot\cdot$}{{T}}) {{Formation}}},
