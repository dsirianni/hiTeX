@article{knizia:2013:4834,
  title = {Intrinsic {{Atomic Orbitals}}: {{An Unbiased Bridge}} between {{Quantum Theory}} and {{Chemical Concepts}}},
  shorttitle = {Intrinsic {{Atomic Orbitals}}},
  author = {Knizia, Gerald},
  year = {2013},
